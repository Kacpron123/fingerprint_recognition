clc; clear all; close all;


img1 = imread(fullfile("Dataset","107_1.tif"));
img2 = imread(fullfile("Dataset","107_2.tif"));

fprintf('Processing Fingerprint 1...\n');
[sig1, terms1, bifs1, mask1] = processFingerprint(img1);

fprintf('Processing Fingerprint 2...\n');
[sig2, terms2, bifs2, mask2] = processFingerprint(img2);

match_score = matchMinutiae(sig1, sig2);

fprintf('Matching Score: %.2f%%\n', match_score);

if match_score > 12 % threshold
    fprintf('Result: MATCH FOUND\n');
else
    fprintf('Result: NO MATCH\n');
end

figure;
subplot(1,2,1); imshow(img1); title('Fingerprint 1');
subplot(1,2,2); imshow(img2); title('Fingerprint 2');